# ===========================
# VerifyX - .gitignore
# ===========================

# Node modules (never push these - huge!)
node_modules/
client/node_modules/
server/node_modules/

# Environment variables (sensitive!)
.env
.env.local
.env.production
server/.env
client/.env

# Build output
client/dist/
client/build/

# Generated certificate PDFs (auto-generated by the app)
server/uploads/certificates/*.pdf

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp

# MongoDB data
data/
